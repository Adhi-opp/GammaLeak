# Copy to deploy/archive.env on the Oracle instance and fill in the bucket.
# The gammaleak-archive.service reads this file. Not secret (the rclone
# Customer Secret Key lives in rclone.conf, not here), but keep it out of git
# anyway — deploy/archive.env is gitignored.

# REQUIRED — the Object Storage bucket you created in the Oracle console.
GAMMALEAK_OCI_BUCKET=gammaleak-data

# OPTIONAL overrides (defaults shown):
# GAMMALEAK_HOME=/opt/gammaleak
# GAMMALEAK_OCI_REMOTE=oci          # rclone remote name (see rclone.conf)
# GAMMALEAK_OCI_PREFIX=gammaleak    # key prefix inside the bucket
# GAMMALEAK_SESSION_CLOSE_HHMM=1540 # minutes after which today is archivable
# RCLONE_CONFIG=/home/ubuntu/.config/rclone/rclone.conf
